#!/usr/bin/env python3

# Waits until automatic_start reports that the UAV can take off (can_takeoff), i.e., its preflight
# checks pass. Arming before that makes automatic_start abort, as the UAV might already be in the air.
#
# If nobody publishes the topic within NO_PUBLISHER_TIMEOUT (e.g., automatic_start is not running), the script
# exits after that time. Once a publisher was seen, it waits for the readiness even if the publisher disappears
# (e.g., automatic_start respawns).

import time
import os
import random
import string
import sys

import rclpy
from rclpy.node import Node

from std_msgs.msg import Bool

NO_PUBLISHER_TIMEOUT = 10.0

class MyNode(Node):

    def __init__(self):

        UAV_NAME = os.environ['UAV_NAME']

        random_str = ''.join(random.choices(string.ascii_uppercase + string.digits, k=8))

        super().__init__("waitForAutomaticStart_{}_{}".format(UAV_NAME, random_str))

        self.topic = "/" + UAV_NAME + "/automatic_start/can_takeoff"

        self.sub = self.create_subscription(Bool, self.topic, self.callback, 10)

        self.ready = False

        self.seen_publisher = False

        self.start_time = time.monotonic()

        self.timer = self.create_timer(1.0, self.doAction)

    def callback(self, msg):
        if msg.data:
            self.ready = True

    def doAction(self):

        if self.ready:
            rclpy.shutdown()

        elif self.seen_publisher or self.count_publishers(self.topic) > 0:
            self.seen_publisher = True
            print("waiting for {} to be true".format(self.topic))

        elif time.monotonic() - self.start_time > NO_PUBLISHER_TIMEOUT:
            print("nobody publishes {}, continuing".format(self.topic))
            rclpy.shutdown()

        else:
            print("waiting for {}".format(self.topic))

def main(args=None):

    if os.getenv('UAV_NAME') is None:
        print('[ERROR]: Environment variable UAV_NAME not set!')
        sys.exit(1)

    rclpy.init(args=args)

    node = MyNode()

    rclpy.spin(node)

if __name__ == '__main__':

    main()
